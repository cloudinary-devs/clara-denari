---
import Layout from '../../layouts/Layout.astro';
import Page from '../../components/Page.astro';
import SecretAgentLayout from '../../components/SecretAgentLayout.astro';
import Typewriter from '../../components/Typewriter.astro';
import NotificationPanel from '../../components/NotificationPanel.astro';
import EvidenceAction from '../../components/EvidenceAction.vue';

const title = 'The Press Kit';
const backdrop = "https://res.cloudinary.com/demo/image/upload/f_auto,q_auto/samples/shoes";
---

<Layout title={title} backdrop={backdrop} fullScreenLayout={true}>
  <div class="prose max-w-none">
    <SecretAgentLayout title={title} backdrop={backdrop} />

    <div class="w-full mb-6">
      <h2 class="text-responsive-xl md:text-responsive-2xl font-bold text-primary mb-4 shadow-lg">
        The Press Kit
      </h2>

      <div class="bg-black bg-opacity-50 border-2 border-border rounded-lg p-6 mb-6">
        <Typewriter
          text="With the verified image locked, the Secret Agent assembles the press kit: a high-resolution image bound to its Content Credentials, the digital paper trail proving which tools touched it, when, and by whom. Clara checks that trail line by line before a single reporter sees it.<br/><br/>'Every tool call is logged,' she says. 'The asset ID, the transformation, the timestamp. If a journalist ever asks how we know this photo is real, we can show our work.'"
          speed={18}
          delay={500}
          class="block mb-4 max-w-prose text-foreground text-responsive-base md:text-responsive-lg leading-relaxed"
        />
      </div>
    </div>

    <NotificationPanel />

    <div class="w-full flex flex-col sm:flex-row gap-4 justify-center mb-6">
      <EvidenceAction id="3" client:load />
    </div>

    <div class="w-full flex justify-center">
      <Page
        url="secret-agent/lab_press"
        action="Attach Content Credentials"
        condition="evidence_3"
        resultText="Press kit assembled. Time to prove where it came from."
      />
    </div>
  </div>
</Layout>
