---
import Layout from '../../layouts/Layout.astro';
import Page from '../../components/Page.astro';
import SecretAgentLayout from '../../components/SecretAgentLayout.astro';
import Typewriter from '../../components/Typewriter.astro';
import NotificationPanel from '../../components/NotificationPanel.astro';
import EvidenceAction from '../../components/EvidenceAction.vue';

const title = 'The Approved Launch Brief';
const backdrop = "https://res.cloudinary.com/demo/image/upload/f_auto,q_auto/samples/coffee";
---

<Layout title={title} backdrop={backdrop} fullScreenLayout={true}>
  <div class="prose max-w-none">
    <SecretAgentLayout title={title} backdrop={backdrop} />

    <div class="w-full mb-6">
      <h2 class="text-responsive-xl md:text-responsive-2xl font-bold text-primary mb-4 shadow-lg">
        The Approved Launch Brief
      </h2>

      <div class="bg-black bg-opacity-50 border-2 border-border rounded-lg p-6 mb-6">
        <Typewriter
          text="Clara unlocks the safe holding the one document everyone agreed on before the sabotage began: the approved launch brief and its asset manifest. The watch's official name, its pricing, three cleared hero shots, and a list of every asset ID authorized for release.<br/><br/>'This is our ground truth,' she tells the Secret Agent. 'Nothing goes out tonight unless it traces back to this brief: not because it looks right, because it's on this list.'<br/><br/>It's a small thing to say out loud, but it's the whole case. The Agent can move at inhuman speed. It cannot decide, on its own, what counts as real."
          speed={18}
          delay={500}
          class="block mb-4 max-w-prose text-foreground text-responsive-base md:text-responsive-lg leading-relaxed"
        />
      </div>
    </div>

    <NotificationPanel />

    <div class="w-full flex flex-col sm:flex-row gap-4 justify-center mb-6">
      <EvidenceAction id="1" client:load />
    </div>

    <div class="w-full flex justify-center">
      <Page
        url="secret-agent/lab_vault"
        action="Brief the Secret Agent"
        condition="evidence_1"
        resultText="The Agent has its instructions. Time to search the vault."
      />
    </div>
  </div>
</Layout>
