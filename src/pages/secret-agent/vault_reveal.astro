---
import Layout from '../../layouts/Layout.astro';
import Page from '../../components/Page.astro';
import SecretAgentLayout from '../../components/SecretAgentLayout.astro';
import Typewriter from '../../components/Typewriter.astro';
import NotificationPanel from '../../components/NotificationPanel.astro';
import EvidenceAction from '../../components/EvidenceAction.vue';

const title = 'What the Vault Turned Up';
const backdrop = "https://res.cloudinary.com/demo/image/upload/f_auto,q_auto/samples/ecommerce/leather-bag-gray";
---

<Layout title={title} backdrop={backdrop} fullScreenLayout={true}>
  <div class="prose max-w-none">
    <SecretAgentLayout title={title} backdrop={backdrop} />

    <div class="w-full mb-6">
      <h2 class="text-responsive-xl md:text-responsive-2xl font-bold text-primary mb-4 shadow-lg">
        What the Vault Turned Up
      </h2>

      <div class="bg-black bg-opacity-50 border-2 border-border rounded-lg p-6 mb-6">
        <Typewriter
          text="The Secret Agent returns instantly with one image matched exactly against the brief's asset ID and launch tag, the verified hero shot of the Vesper No. 1. Beside it sit a dozen near-identical fakes: some blurred, some re-lit, one with the price quietly changed. The Agent flagged all of them, correctly, as not on the approved list.<br/><br/>'It didn't guess which one looked most real,' Clara says. 'It just checked which one was allowed.' That's the difference between an agent and an accomplice."
          speed={18}
          delay={500}
          class="block mb-4 max-w-prose text-foreground text-responsive-base md:text-responsive-lg leading-relaxed"
        />
      </div>
    </div>

    <NotificationPanel />

    <div class="w-full flex flex-col sm:flex-row gap-4 justify-center mb-6">
      <EvidenceAction id="2" client:load />
      <EvidenceAction
        actionType="text"
        label="Quarantine the counterfeit hero shots"
        resultText="The fakes are pulled out of the workflow entirely: tagged, logged, and cut off from every channel about to go live."
        client:load
      />
    </div>

    <div class="w-full flex justify-center">
      <Page
        url="secret-agent/lab_social"
        action="Prepare the Social Crop"
        condition="evidence_2"
        resultText="Verified image locked in. Time to shape it for social."
      />
    </div>
  </div>
</Layout>
