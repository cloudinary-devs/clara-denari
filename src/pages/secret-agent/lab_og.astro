---
import Layout from '../../layouts/Layout.astro';
import SecretAgentLayout from '../../components/SecretAgentLayout.astro';
import NotificationPanel from '../../components/NotificationPanel.astro';

const title = 'Lab: Size the Share Image';
const backdrop = "https://res.cloudinary.com/demo/image/upload/f_auto,q_auto/samples/landscapes/nature-mountains";
---

<Layout title={title} backdrop={backdrop} fullScreenLayout={true}>
  <div class="prose max-w-none">
    <SecretAgentLayout title={title} backdrop={backdrop} imageClass="lg:w-1/3 md:w-1/3" />

    <div class="w-full mb-6">
      <h2 class="text-2xl font-bold text-primary mb-4 shadow-lg">
        Lab S4: Size the Share Image
      </h2>

      <div class="bg-black bg-opacity-50 border-2 border-border rounded-lg p-6 mb-6">
        <div class="text-foreground text-lg leading-relaxed" style="text-shadow: 0 0 3px rgba(0, 255, 0, 0.5);">
          The last asset in the dossier is the link-preview image: the one people will see first when the launch announcement gets shared. Try the transformation in the sandbox below, then complete the lab test.
        </div>
      </div>
    </div>

    <NotificationPanel />

    <div class="w-full flex flex-col sm:flex-row gap-4 justify-center">
      <button
        id="sandbox-btn"
        class="bg-gradient-to-br from-secondary to-muted text-muted-foreground border-2 border-border px-6 py-3 text-lg rounded-lg hover:from-primary hover:to-brick-deep hover:text-primary-foreground transition-all duration-200 shadow-lg font-bold"
        style="text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8);"
      >
        🧪 Lab
      </button>
    </div>
  </div>
</Layout>
