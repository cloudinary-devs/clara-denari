---
import Layout from '../../layouts/Layout.astro';
import SecretAgentLayout from '../../components/SecretAgentLayout.astro';
import NotificationPanel from '../../components/NotificationPanel.astro';
import evidenceData from '../../data/secretAgentEvidence.json';

const title = 'Midnight Dossier';
const backdrop = "https://res.cloudinary.com/demo/image/upload/f_auto,q_auto/sample";
---

<Layout title={title} backdrop={backdrop} fullScreenLayout={true}>
  <div class="prose max-w-none">
    <SecretAgentLayout title={title} backdrop={backdrop} />

    <div class="w-full mb-6">
      <h2 class="text-2xl font-bold text-blue-400 mb-4 shadow-lg">
        Midnight Dossier
      </h2>

      <div class="bg-black bg-opacity-50 border-2 border-blue-500 rounded-lg p-6 mb-6">
        <div class="text-gray-100 text-lg leading-relaxed">
          <p class="mb-4">
            The clock is almost at midnight. Clara opens the dossier one last time to confirm every piece of evidence traces back to the approved launch brief before the channels fire automatically.
          </p>

          <!-- Success message - only shown when all evidence is logged -->
          <div id="success-message" class="bg-green-900 bg-opacity-30 border border-green-500 rounded p-4 mt-6 hidden">
            <h3 class="text-green-400 font-bold text-xl mb-2">🎉 Launch Approved!</h3>
            <p class="text-green-200">
              At 11:59, Clara closes the dossier: the launch brief, the verified hero image, the press kit with its Content Credentials intact, and the email and social assets — every one of them traced back to a single approved source. The counterfeit material sits quarantined, flagged, and out of reach of every channel about to go live.
              At midnight, Maison Vesper's true campaign, and nothing else, reaches the world.
            </p>
            <p class="text-green-200 mt-4 font-semibold">
              The Secret Agent decided how to execute the work. Clara decided what was true, permitted, and worth putting into the world.
            </p>
          </div>

          <!-- Message shown when evidence is missing -->
          <div id="incomplete-message" class="bg-red-900 bg-opacity-30 border border-red-500 rounded p-4 mt-6">
            <h3 class="text-red-400 font-bold text-xl mb-2">🔍 Dossier Incomplete</h3>
            <p class="text-red-200 mb-3">
              It's almost midnight, and the dossier isn't complete. Go back through the investigation and make sure every piece of verified evidence has been logged before the launch goes out.
            </p>
            <div class="text-red-300 text-sm">
              <p class="font-semibold mb-2">Evidence still needed:</p>
              <ul id="missing-items" class="list-disc list-inside space-y-1">
                <!-- Will be populated by JavaScript -->
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>

    <NotificationPanel />

    <div class="w-full flex justify-center">
      <div class="text-center">
        <button
          id="return-button"
          onclick="window.location.href='/'"
          class="px-8 py-4 bg-gradient-to-br from-blue-600 to-purple-600 text-white rounded-lg hover:from-blue-500 hover:to-purple-500 transition-all duration-200 font-bold text-lg shadow-lg"
        >
          🏠 Return to Start
        </button>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ evidenceNames: evidenceData.map((e) => e.name) }}>
  document.addEventListener('DOMContentLoaded', () => {
    const successMessage = document.getElementById('success-message');
    const incompleteMessage = document.getElementById('incomplete-message');
    const missingItemsList = document.getElementById('missing-items');

    if (!successMessage || !incompleteMessage || !missingItemsList) {
      console.error('Required DOM elements not found');
      return;
    }

    const evidenceItems = JSON.parse(localStorage.getItem('secret_agent_evidence') || '{}');
    const allIds = ['1', '2', '3', '4'];
    const missingIds = allIds.filter((id) => evidenceItems[id] !== true);

    if (missingIds.length === 0) {
      successMessage.classList.remove('hidden');
      incompleteMessage.classList.add('hidden');
    } else {
      successMessage.classList.add('hidden');
      incompleteMessage.classList.remove('hidden');

      missingItemsList.innerHTML = '';
      missingIds.forEach((id) => {
        const li = document.createElement('li');
        li.textContent = evidenceNames[parseInt(id) - 1] || `Evidence ${id}`;
        missingItemsList.appendChild(li);
      });
    }
  });
</script>
